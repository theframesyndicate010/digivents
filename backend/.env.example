NODE_ENV=production
PORT=3000

# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=https://your-domain.example

# Use long, random values in deployment.
ACCESS_TOKEN_SECRET=<long-random-secret>
REFRESH_TOKEN_SECRET=<different-long-random-secret>

# Set to true only when serving over HTTPS.
COOKIE_SECURE=true

# Database configuration.
DATABASE_CLIENT=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3307
DATABASE_NAME=digivents
DATABASE_USERNAME=digivents_user
DATABASE_PASSWORD=digivents_password

# Optional alternatives for local SQLite or hosted connection strings.
# DATABASE_URL=
# DATABASE_FILENAME=.tmp/data.db
# LOCAL_DATABASE_PORT=3307

# Public URL prefix used for uploaded file links.
BASE_URL=https://your-domain.example
UPLOAD_DIR=public/uploads

# Optional login rate-limit overrides.
# RATE_LIMIT_LOGIN_WINDOW=900000
# RATE_LIMIT_LOGIN_MAX=5
